{
    "name": "ruvelo/laravel-help-center",
    "description": "A public help center for Laravel: FAQ and knowledge base with categories, instant search, \"Was this helpful?\" feedback and an editor with live preview.",
    "keywords": [
        "laravel",
        "help-center",
        "knowledge-base",
        "faq",
        "support",
        "documentation",
        "markdown"
    ],
    "license": "MIT",
    "type": "library",
    "homepage": "https://ruvelo.github.io/laravel-help-center/",
    "authors": [
        {
            "name": "François Bultez",
            "homepage": "https://github.com/francoisbultez",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.4.1|^13.0",
        "league/commonmark": "^2.6"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/mcp": "^1.0",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "suggest": {
        "laravel/mcp": "Serve the help center to AI agents and support chatbots over MCP (^1.0)."
    },
    "autoload": {
        "psr-4": {
            "Ruvelo\\HelpCenter\\": "src/",
            "Ruvelo\\HelpCenter\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ruvelo\\HelpCenter\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ruvelo\\HelpCenter\\HelpCenterServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=1G",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ],
        "demo": "php demo/build.php build/site && cp -r art build/site/art && echo 'Serve it: php -S 127.0.0.1:8000 -t build, then open /site/'"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "support": {
        "issues": "https://github.com/Ruvelo/laravel-help-center/issues",
        "source": "https://github.com/Ruvelo/laravel-help-center"
    },
    "scripts-descriptions": {
        "test": "Run the test suite",
        "lint": "Check code style",
        "format": "Fix code style",
        "analyse": "Run static analysis",
        "check": "Lint, analyse and test: what CI runs",
        "demo": "Build the static demo site into build/"
    }
}
